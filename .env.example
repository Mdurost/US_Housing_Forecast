# Copy to .env and replace every value. .env is git-ignored; never commit real secrets.
#   PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))   -> random secret

# FastAPI: required header value for /pipeline/* endpoints (X-API-Key)
HOUSING_FORECAST_API_KEY=change-me-api-key

# Airflow admin login (UI at http://localhost:8080 and REST API used by FastAPI)
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me-airflow-password

# Shared secret for Airflow's internal JWT tokens and its metadata database password
AIRFLOW_JWT_SECRET=change-me-jwt-secret
AIRFLOW_DB_PASSWORD=change-me-db-password

# Optional pipeline settings
# HOUSING_FORECAST_SCHEDULE=0 6 15 * *
# HOUSING_FORECAST_CLI_ARGS=--set trainer.max_epochs=50
# HOUSING_FORECAST_HOST_DIR=.      # host folder holding data/, models/, outputs/, mlruns/
